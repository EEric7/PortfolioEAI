@page
@model Error404Model
@{
    ViewData["Title"] = "Error 404";
}

<section class="error-section">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center" style="background-color: rgba(240, 248, 255, 0.80); min-height: 60;">
        <div class="d-flex justify-content-center">
            <div class="text-center" style="margin: 30px;">
                <h1 class="text-danger mb-4">@ViewData["Title"]</h1>
                <h2 class="text-black mb-4">Page ou ressource non trouvée</h2>
                <p class="mb-4">La ressource demandée n'existe pas ou a été supprimée.</p>
                <a class="btn btn-primary" asp-area="" asp-page="/Index">Retour à l'accueil</a>
            </div>
        </div>
    </div>
</section>
