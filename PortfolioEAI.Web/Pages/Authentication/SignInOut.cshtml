@page
@model PortfolioEAI.Web.Pages.Authentication.SignInOutModel
@{
    ViewData["Title"] = "SignIn";
}

@await Html.PartialAsync("_MenuHome")

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <img src="~/assets/EAI.png" alt="Logo" style="width: 60px;" class="mb-2" />
            <h2 class="h4 mb-0">Connexion</h2>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label"></label>
                <input asp-for="Input.UserName" class="form-control" placeholder="Nom d'utilisateur" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" placeholder="Mot de passe" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2">Se connecter</button>
        </form>
        <a href="/" class="btn btn-outline-secondary w-100">Retour à la page vitrine</a>
    </div>
</div>

@section Scripts 
{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}