@page
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using PortfolioEAI.Web.Models
@using PortfolioEAI.Web.Ressources
@model IndexModel
@{
    ViewData["Title"] = Model.AccueilModel?.DTO?.UserName ?? UIText.DefaultTitle;
    ViewData["SubTitle"] = Model.AccueilModel?.DTO?.Profession ?? UIText.DefaultProfession;
    ViewData["UserName"] = Model.AccueilModel?.DTO?.UserName;
    ViewData["Description"] = Model.AccueilModel?.DTO?.Description;
    ViewData["Address"] = Model.AccueilModel?.DTO?.Address;
    ViewData["GITEmail"] = Model.AccueilModel?.DTO?.EmailGitHub;
    ViewData["EMail"] = Model.AccueilModel?.DTO?.Email;
    ViewData["PhoneNumber"] = Model.AccueilModel?.DTO?.PhoneNumber;

    // Determine if there are skills and projects to display
    Boolean hasSkills = Model.AccueilModel?.SkillsModelLanguages is null ? false : Model.AccueilModel.SkillsModelLanguages.Any();
    Boolean hasProjects = Model.AccueilModel?.ProjectModelDisplay is null ? false : Model.AccueilModel.ProjectModelDisplay.Any();
    int dispatch = Model.AccueilModel?.ProjectModelDisplay is null ? 0 : Model.AccueilModel.ProjectModelDisplay.Count();
}

@await Html.PartialAsync("_Menu", Model.AccueilModel?.MenuModel)

<!--Master Head-->
<header class="masthead">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center">
                <h1 class="mx-auto my-0 text-uppercase">@ViewData["Title"]</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5">@ViewData["SubTitle"]</h2>
                <a class="btn btn-primary" href="#about"> @UIText.WhoAmIButton</a>
            </div>
        </div>
    </div>
</header>

<!-- 
About-->
<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white mb-4">@ViewData["UserName"]</h2>
                <p class="text-white-50">
                    @ViewData["Description"]
                </p>
            </div>
        </div>
        <img class="img-fluid" src="assets/img/Moi.png" alt="@UIText.ProfileImageAlt" />
    </div>
</section>

<!-- Projects-->
<section class="projects-section bg-light" id="skills">
    <div class="container px-4 px-lg-5">
         <!-- Featured Compétence Row-->
        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">
                @if (hasSkills)
                {
                    <h2 class="text-black mb-4">@UIText.SkillsLanguageHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel?.SkillsModelLanguages!)
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@(int.TryParse(skill.Level, out var level) ? level : 0)%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.SkillsModelFrameworks!)
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@(int.TryParse(skill.Level, out var level) ? level : 0)%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <h2 class="text-black mb-4">@UIText.SkillsWorkflowHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.SkillsModelDesign!)
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@(int.TryParse(skill.Level, out var level) ? level : 0)%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    
                    <h2 class="text-black mb-4">@UIText.CVHeader</h2>
                    <a href="#!">
                        <img class="img-fluid" src="assets/cv.ico" alt="@UIText.CVImageAlt" width="300" height="300"/>
                        @UIText.DownloadLabel
                    </a>
                </div>
            </div>
        </div>

        <h2 class="text-black mb-4" id="projects">@UIText.ExperiencesHeader</h2>
        @if (hasProjects) {
            @foreach (var project in Model.AccueilModel?.ProjectModelDisplay ?? Enumerable.Empty<ProjectModel>()) {
                @if ((dispatch % 2) == 1) {
                    <!-- Project One Row-->
                    <div class="row gx-0 mb-5 mb-lg-0 justify-content-center">
                        <div class="col-lg-6">
                            <img class="img-fluid" src=@(project.ImageUrl) alt="@UIText.ProjectImageAlt" />
                        </div>
                        <div class="col-lg-6">
                            <div class="bg-black text-center h-100 project">
                                <div class="d-flex h-100">
                                    <div class="project-text w-100 my-auto text-center text-lg-left">
                                        <h4 class="text-white">@(project.Title)</h4>
                                        <p class="mb-0 text-white-50">
                                            @(project.Description)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                } 
                else {
                    <!-- Project Two Row-->
                    <div class="row gx-0 justify-content-center">
                        <div class="col-lg-6">
                            <img class="img-fluid" src=@(project.ImageUrl) alt="@UIText.ProjectImageAlt" />
                        </div>
                        <div class="col-lg-6 order-lg-first">
                            <div class="bg-black text-center h-100 project">
                                <div class="d-flex h-100">
                                    <div class="project-text w-100 my-auto text-center text-lg-right">
                                        <h4 class="text-white">
                                            @(project.Title)
                                        </h4>
                                        <p class="mb-0 text-white-50">
                                            @(project.Description)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                dispatch--;
            }
        }
    </div>
</section>

<!-- Credit-->
<section class="signup-section" id="privacy">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <h2 class="text-white mb-4">@UIText.ProjectsTitle</h2>
                <p class="text-white-50">
                    @UIText.ProjectsDescription
                    <a href="@UIText.LinkGrayscale" target="_blank" rel="noopener noreferrer">Start Bootstrap</a>
                </p>
            </div>
         </div>
    </div>
</section>

<!-- Contact-->
<section class="contact-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@ViewData["Address"]</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">
                            <a href="mailto:@ViewData["EMail"]">
                                @ViewData["EMail"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@ViewData["PhoneNumber"]</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="social d-flex justify-content-center">
            <a class="mx-2" href=@ViewData["GITEmail"]>
                <i class="fab fa-github"></i>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js"></script>
}