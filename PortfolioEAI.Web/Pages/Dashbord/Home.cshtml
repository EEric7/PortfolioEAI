@page
@model PortfolioEAI.Web.Pages.Dashbord.HomeModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Navbar -->
@await Html.PartialAsync("_MenuHome", Model)

<section class="container-fluid py-4" id="dashboard">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Dashboard</h1>
            <div>
                <button class="btn btn-outline-primary me-2">
                    <i class="fas fa-share-alt"></i> Partager
                </button>
                <button class="btn btn-outline-secondary me-2">
                    <i class="fas fa-file-export"></i> Exporter
                </button>
                <button class="btn btn-outline-info">
                    <i class="fas fa-calendar-week"></i> Cette semaine
                </button>
            </div>
        </div>
    </div>

    <!-- Statistiques rapides -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h5 class="card-title">Projets</h5>
                    <p class="display-6">12</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h5 class="card-title">Compétences</h5>
                    <p class="display-6">8</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h5 class="card-title">Expériences</h5>
                    <p class="display-6">5</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h5 class="card-title">Messages</h5>
                    <p class="display-6">3</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau de données -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Dernières activités</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Type</th>
                                <th scope="col">Description</th>
                                <th scope="col">Date</th>
                                <th scope="col">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>Projet</td>
                                <td>Ajout du projet "Portfolio"</td>
                                <td>15/10/2025</td>
                                <td><span class="badge bg-success">Terminé</span></td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Message</td>
                                <td>Nouveau message reçu</td>
                                <td>14/10/2025</td>
                                <td><span class="badge bg-info">Nouveau</span></td>
                            </tr>
                            <!-- Ajoute d'autres lignes dynamiquement -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>