@page
@model PortfolioEAI.Web.Pages.Dashbord.Skills.DeleteModel

@{
    ViewData["Title"] = "Supprimer une compétence";
}

@await Html.PartialAsync("_MenuHome", Model.SkillDeleteModel.MenuModel)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Supprimer la compétence</h4>
                <small class="text-muted">@Model.SkillDeleteModel.DTO.Name</small>
            </div>
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>

        <div class="card-body">
            @if (Model.SkillDeleteModel.DTO == null)
            {
                <div class="alert alert-warning mb-0">Compétence introuvable.</div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-8">
                        <dl class="row mb-4">
                            <dt class="col-sm-4">Nom</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => Model.SkillDeleteModel.DTO.Name)</dd>

                            <dt class="col-sm-4">Niveau</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => Model.SkillDeleteModel.DTO.Level)</dd>

                            <dt class="col-sm-4">Catégorie</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => Model.SkillDeleteModel.DTO.Category)</dd>
                        </dl>
                    </div>

                    <div class="col-md-4 text-center">
                        <div class="border rounded p-3 mb-3" style="min-height:120px; display:flex; align-items:center; justify-content:center;">
                            <i class="fas fa-brain fa-2x text-muted"></i>
                        </div>
                        <div class="small text-muted">ID : @Model.SkillDeleteModel.DTO.Id</div>
                    </div>
                </div>

                <hr />

                <form method="post" onsubmit="return confirm('Confirmez-vous la suppression de cette compétence ?');">
                    <input type="hidden" asp-for="SkillDeleteModel.DTO.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt me-1"></i> Supprimer
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            }
        </div>
    </div>
</section>
