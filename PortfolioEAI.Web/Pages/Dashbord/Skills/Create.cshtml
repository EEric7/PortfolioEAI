@page
@using PortfolioEAI.Domain.Enums
@model PortfolioEAI.Pages.Dashbord.Skills.CreateModel

@{
    ViewData["Title"] = "Ajouter une compétence";
}

@await Html.PartialAsync("_MenuHome", Model)

<section class="container py-4">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Nouvelle compétence</h2>
            <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>

                        <div class="mb-3">
                            <label asp-for="Skill.Name" class="form-label"></label>
                            <input asp-for="Skill.Name" class="form-control" placeholder="Nom de la compétence" />
                            <span asp-validation-for="Skill.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skill.Level" class="form-label"></label>
                            <select asp-for="Skill.Level" asp-items="Html.GetEnumSelectList<SkillLevel>()" class="form-select">
                            </select>
                            <span asp-validation-for="Skill.Level" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skill.Category" class="form-label"></label>
                            <select asp-for="Skill.Category" asp-items="Html.GetEnumSelectList<SkillCategory>()" class="form-select">
                            </select>
                            <span asp-validation-for="Skill.Category" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-1"></i> Créer
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Conseils</h6>
                    <ul class="small mb-0">
                        <li>Choisis un nom clair pour la compétence.</li>
                        <li>Le niveau peut être un entier ou une étiquette (Débutant, Intermédiaire, Avancé).</li>
                        <li>Classe la compétence dans la catégorie appropriée pour faciliter le tri.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
