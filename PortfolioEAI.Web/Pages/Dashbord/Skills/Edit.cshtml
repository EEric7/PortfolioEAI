@page
@model PortfolioEAI.Web.Pages.Dashbord.Skills.EditModel

@{
    ViewData["Title"] = "Modifier une compétence";
}

@await Html.PartialAsync("_MenuHome", Model.SkillEditeModel.MenuModel)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Modifier la compétence</h4>
                <small class="text-muted">@Model.SkillEditeModel.DTO.Name</small>
            </div>
            <div>
                <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        <div class="card-body">
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>
                <input type="hidden" asp-for="SkillEditeModel.DTO.Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="SkillEditeModel.DTO.Name" class="form-label"></label>
                            <input asp-for="SkillEditeModel.DTO.Name" class="form-control" placeholder="Nom de la compétence" />
                            <span asp-validation-for="SkillEditeModel.DTO.Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SkillEditeModel.DTO.Level" class="form-label"></label>
                                <select asp-for="SkillEditeModel.DTO.Level" class="form-select" asp-items="@Model.SkillEditeModel.LevelOptions">
                                    <option value="">-- Sélectionner --</option>
                                </select>
                                <span asp-validation-for="SkillEditeModel.DTO.Level" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SkillEditeModel.DTO.Category" class="form-label"></label>
                                <select asp-for="SkillEditeModel.DTO.Category" class="form-select" asp-items="@Model.SkillEditeModel.CategoryOptions">
                                    <option value="">-- Sélectionner --</option>
                                </select>
                                <span asp-validation-for="SkillEditeModel.DTO.Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Enregistrer
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 h-100">
                            <div class="card-body text-center">
                                <h6 class="mb-2">Aperçu</h6>
                                <div class="border rounded p-3 mb-3 d-flex align-items-center justify-content-center" style="min-height:120px;">
                                    <i class="fas fa-brain fa-3x text-primary"></i>
                                </div>
                                <p class="small text-muted mb-0">ID : @Model.SkillEditeModel.DTO.Id</p>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
