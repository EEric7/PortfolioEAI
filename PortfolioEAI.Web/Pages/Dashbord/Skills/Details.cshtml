@page
@model PortfolioEAI.Pages.Dashbord.Skills.DetailsModel

@{
    ViewData["Title"] = "Détails de la compétence";
}

@await Html.PartialAsync("_MenuHome", Model)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Détails</h4>
                <small class="text-muted">@Model.Skill?.Name</small>
            </div>
            <div class="btn-group">
                <a asp-page="./Edit" asp-route-id="@Model.Skill?.Id" class="btn btn-sm btn-warning">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
                <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (Model.Skill == null)
            {
                <div class="alert alert-warning mb-0">Compétence introuvable.</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-md-8">
                        <h6 class="mb-3">Informations</h6>

                        <dl class="row">
                            <dt class="col-sm-3">Nom</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.Skill.Name)</dd>

                            <dt class="col-sm-3">Niveau</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.Skill.Level)</dd>

                            <dt class="col-sm-3">Catégorie</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.Skill.Category)</dd>

                            <dt class="col-sm-3">ID</dt>
                            <dd class="col-sm-9"><span class="text-muted">@Model.Skill.Id</span></dd>
                        </dl>
                    </div>

                    <div class="col-md-4">
                        <div class="text-center">
                            <h6 class="mb-3">Aperçu</h6>
                            <div class="border rounded p-3 mb-3 d-flex align-items-center justify-content-center" style="min-height:140px;">
                                <i class="fas fa-brain fa-3x text-primary"></i>
                            </div>
                            <p class="small text-muted mb-0">Utilise les boutons ci‑dessous pour modifier ou retourner à la liste.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
