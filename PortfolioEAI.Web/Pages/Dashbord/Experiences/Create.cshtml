@page
@model PortfolioEAI.Web.Pages.Dashbord.Experiences.CreateModel

@{
    ViewData["Title"] = "Ajouter une expérience";
}

@await Html.PartialAsync("_MenuHome", Model.ExperienceCreateModel.MenuModel)

<section class="container py-4">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Ajouter une expérience</h2>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>

                        <div class="mb-3">
                            <label asp-for="ExperienceCreateModel.DTO.Company" class="form-label"></label>
                            <input asp-for="ExperienceCreateModel.DTO.Company" class="form-control" placeholder="Nom de l'entreprise" />
                            <span asp-validation-for="ExperienceCreateModel.DTO.Company" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 mt-3">
                            <label asp-for="ExperienceCreateModel.DTO.Description" class="form-label"></label>
                            <textarea asp-for="ExperienceCreateModel.DTO.Description" class="form-control" rows="4" placeholder="Résumé de la mission / responsabilités"></textarea>
                            <span asp-validation-for="ExperienceCreateModel.DTO.Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExperienceCreateModel.DTO.Enseigne" class="form-label"></label>
                            <input asp-for="ExperienceCreateModel.DTO.Enseigne" name="PhotoFile" type="file" class="form-control" placeholder="URL du logo / image (optionnel)"/>
                            <span asp-validation-for="ExperienceCreateModel.DTO.Enseigne" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check"></i> Enregistrer
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="mb-3">Aperçu</h6>
                    <div id="photoPreview" class="border rounded p-3">
                        <p class="text-muted">Aucune image sélectionnée</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_FileInputScriptsPartial");}
}
