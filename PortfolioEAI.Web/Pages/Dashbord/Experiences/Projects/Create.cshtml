@page
@model PortfolioEAI.Web.Pages.Experiences.Projects.CreateModel

@{
    ViewData["Title"] = "Créer un projet";
}

@await Html.PartialAsync("_MenuHome", Model.ProjectCreateModel.MenuModel)

<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Nouveau projet</h2>
            <small class="text-muted">Ajoutez un projet au portfolio</small>
        </div>
        <div>
            <a asp-page="../Details" asp-route-id="@Model.ProjectCreateModel.ExperienceDTO?.Id" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>

                        <div class="mb-3">
                            <label asp-for="ProjectCreateModel.DTO.Title" class="form-label"></label>
                            <input asp-for="ProjectCreateModel.DTO.Title" class="form-control" placeholder="Titre du projet" />
                            <span asp-validation-for="ProjectCreateModel.DTO.Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProjectCreateModel.DTO.Position" class="form-label"></label>
                            <input asp-for="ProjectCreateModel.DTO.Position" class="form-control" placeholder="Poste occupé" />
                            <span asp-validation-for="ProjectCreateModel.DTO.Position" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ProjectCreateModel.DTO.StartDate" class="form-label"></label>
                                <input asp-for="ProjectCreateModel.DTO.StartDate" type="date" class="form-control" />
                                <span asp-validation-for="ProjectCreateModel.DTO.StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ProjectCreateModel.DTO.EndDate" class="form-label"></label>
                                <input asp-for="ProjectCreateModel.DTO.EndDate" type="date" class="form-control" />
                                <span asp-validation-for="ProjectCreateModel.DTO.EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProjectCreateModel.DTO.Description" class="form-label"></label>
                            <textarea asp-for="ProjectCreateModel.DTO.Description" class="form-control" rows="5" placeholder="Brève description"></textarea>
                            <span asp-validation-for="ProjectCreateModel.DTO.Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ProjectCreateModel.PhotoFile" class="form-label">Photo du projet</label>
                                <input type="file" name="PhotoFile" class="form-control" accept="image/*" />
                                <small class="text-muted">Formats acceptés : JPG, PNG, GIF, WebP (max 5 MB)</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-1"></i> Enregistrer
                            </button>
                            <a asp-page="../Details" asp-route-id="@Model.ProjectCreateModel.ExperienceDTO?.Id" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    <h6 class="mb-3">Aperçu image</h6>
                    <div id="photoPreview" class="border rounded p-2 text-center" style="height:200px; overflow:hidden;">
                        <p class="text-muted">Aucune image sélectionnée</p>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title mb-2">Conseils</h6>
                    <ul class="small mb-0">
                        <li>Utilise des images au format paysage pour un meilleur rendu.</li>
                        <li>Vérifie que l'URL commence par <code>http</code> ou <code>https</code>.</li>
                        <li>La description doit être concise (100–200 caractères).</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_FileInputScriptsPartial");}
}
