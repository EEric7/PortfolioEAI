@page
@model PortfolioEAI.Pages.Experiences.Projects.DetailsModel

@{
    ViewData["Title"] = "Détails du projet";
}

@await Html.PartialAsync("_MenuHome", Model)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">@Model.Project?.Title ?? "Détails du projet"</h4>
                <small class="text-muted">@Model.Project?.Id.ToString()</small>
            </div>
            <div class="btn-group">
                <a asp-page="../Projects/Edit" asp-route-id="@Model.Project?.Id" class="btn btn-sm btn-warning">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
                <a asp-page="../Details" asp-route-id="@Model.ExperienceId" class="btn btn-sm btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (Model.Project == null)
            {
                <div class="alert alert-warning mb-0">Projet introuvable.</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-md-8">
                        <dl class="row">
                            <dt class="col-sm-3">Titre</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.Project.Title)</dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">
                                <p class="mb-0">@Html.DisplayFor(m => m.Project.Description)</p>
                            </dd>

                            <dt class="col-sm-3">URL</dt>
                            <dd class="col-sm-9">
                                @if (!string.IsNullOrEmpty(Model.Project.Url))
                                {
                                    <a href="@Model.Project.Url" target="_blank" rel="noopener noreferrer">@Model.Project.Url</a>
                                }
                                else
                                {
                                    <span class="text-muted">Aucune URL</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-4">
                        <div class="text-center">
                            <h6 class="mb-3">Aperçu</h6>
                            <div class="border rounded p-2 mb-2" style="min-height:160px; display:flex; align-items:center; justify-content:center;">
                                @if (!string.IsNullOrEmpty(Model.Project.ImageUrl))
                                {
                                    <img src="@Model.Project.ImageUrl" alt="@Model.Project.Title" class="img-fluid rounded" style="max-height:140px;" />
                                }
                                else
                                {
                                    <img src="~/assets/placeholder-image.png" alt="Aperçu" class="img-fluid rounded" style="max-height:140px;" />
                                }
                            </div>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.Project.Url))
                                {
                                    <a class="btn btn-sm btn-outline-primary ms-1" href="@Model.Project.Url" target="_blank" rel="noopener noreferrer">
                                        <i class="fas fa-external-link-alt me-1"></i> Voir
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
