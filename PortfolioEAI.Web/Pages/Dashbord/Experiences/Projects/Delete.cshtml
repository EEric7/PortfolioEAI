@page
@model PortfolioEAI.Web.Pages.Experiences.Projects.DeleteModel

@{
    ViewData["Title"] = "Supprimer un projet";
}

@await Html.PartialAsync("_MenuHome", Model)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Supprimer le projet</h4>
                <small class="text-muted">@Model.ProjectDeleteModel?.DTO.Title</small>
            </div>
            <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>

        <div class="card-body">
            @if (Model.ProjectDeleteModel?.DTO == null)
            {
                <div class="alert alert-warning mb-0">Projet introuvable.</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-md-8">
                        <dl class="row">
                            <dt class="col-sm-3">Titre</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.ProjectDeleteModel.DTO.Title)</dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.ProjectDeleteModel.DTO.Description)</dd>

                            <dt class="col-sm-4">Poste</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.ProjectDeleteModel.DTO.Position)</dd>

                            <dt class="col-sm-4">Début</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.ProjectDeleteModel.DTO.StartDate)</dd> 
                            <dt class="col-sm-4">Fin</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.ProjectDeleteModel.DTO.EndDate)</dd>

                            <dt class="col-sm-3">URL</dt>
                            <dd class="col-sm-9">
                                @if (!string.IsNullOrWhiteSpace(Model.ProjectDeleteModel.DTO.Url))
                                {
                                    <a href="@Model.ProjectDeleteModel.DTO.Url" target="_blank" rel="noopener noreferrer">@Model.ProjectDeleteModel.DTO.Url</a>
                                }
                                else
                                {
                                    <span class="text-muted">Aucune URL</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-4 text-center">
                        <h6 class="mb-2">Aperçu</h6>
                        <div class="border rounded p-2 mb-3 d-flex align-items-center justify-content-center" style="min-height:160px;">
                            @if (!string.IsNullOrEmpty(Model.ProjectDeleteModel.DTO.ImageUrl?.ImageDataUrl))
                            {
                                <img src="@Model.ProjectDeleteModel.DTO.ImageUrl!.ImageDataUrl" alt="@Model.ProjectDeleteModel.DTO.Title" class="img-fluid rounded" style="max-height:140px; object-fit:contain;" />
                            }
                            else
                            {
                                <img src="~/assets/placeholder-image.png" alt="Aperçu" class="img-fluid rounded" style="max-height:140px;" />
                            }
                        </div>
                        <div class="small text-muted">ID : @Model.ProjectDeleteModel.DTO.Id</div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center justify-content-center">
                        <div class="text-center w-100">
                            <p class="mb-2"><strong>Période</strong></p>
                            <p class="mb-1">
                                @(Model.ProjectDeleteModel.DTO.StartDate is DateOnly s ? s.ToString("dd/MM/yyyy") : "-")
                                &nbsp;–&nbsp;
                                @(Model.ProjectDeleteModel.DTO.EndDate is DateOnly e ? e.ToString("dd/MM/yyyy") : "Présent")
                            </p>
                            <p class="text-muted small">ID : @Model.ProjectDeleteModel.DTO.Id</p>
                        </div>
                    </div>
                </div>

                <hr />

                <form method="post" onsubmit="return confirm('Confirmez-vous la suppression de ce projet ?');">
                    <input type="hidden" asp-for="ProjectDeleteModel.DTO.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt me-1"></i> Supprimer
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            }
        </div>
    </div>
</section>
