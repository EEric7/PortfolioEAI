@page
@model PortfolioEAI.Web.Pages.Dashbord.Experiences.DeleteModel

@{
    ViewData["Title"] = "Supprimer une expérience";
}

@await Html.PartialAsync("_MenuHome", Model.ExperienceDeleteModel.MenuModel)

<section class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Supprimer une expérience</h4>
                <small class="text-muted">Vérifiez les informations avant suppression</small>
            </div>
            <div>
                <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (Model.ExperienceDeleteModel.Experience == null)
            {
                <div class="alert alert-warning mb-0">Expérience introuvable.</div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-8">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Entreprise</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.ExperienceDeleteModel.Experience.Company)</dd>

                            <dt class="col-sm-4 align-self-start">Description</dt>
                            <dd class="col-sm-8">@Html.DisplayFor(m => m.ExperienceDeleteModel.Experience.Description)</dd>

                            <dt class="col-sm-4">Image</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.ExperienceDeleteModel.Experience.Enseigne?.ImageDataUrl))
                                {
                                    <img src="@Model.ExperienceDeleteModel.Experience.Enseigne!.ImageDataUrl" alt="Image expérience" class="img-fluid rounded shadow-sm" style="max-height:120px;" />
                                }
                                else
                                {
                                    <span class="text-muted">Aucune image</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <hr />

                <form method="post" onsubmit="return confirm('Confirmez-vous la suppression de cette expérience ?');">
                    <input type="hidden" asp-for="ExperienceDeleteModel.Experience.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt"></i> Supprimer
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            }
        </div>
    </div>
</section>
