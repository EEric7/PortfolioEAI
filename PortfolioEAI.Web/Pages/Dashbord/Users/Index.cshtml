@page
@model PortfolioEAI.Web.Pages.Dashbord.Users.IndexModel

@{
    ViewData["Title"] = "Users";
}

@await Html.PartialAsync("_MenuHome", Model.UserIndexModel.MenuModel)

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserIndexModel.UserModels[0].DTO!.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserIndexModel.UserModels[0].DTO!.Password)
            </th>
            <th>
                
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.UserIndexModel.UserModels) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DTO!.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DTO!.Password)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.DTO!.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.DTO!.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.DTO!.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
