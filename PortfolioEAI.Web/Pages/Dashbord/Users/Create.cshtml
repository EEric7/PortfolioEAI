@page
@model PortfolioEAI.Web.Pages.Dashbord.Users.CreateModel

@{
ViewData["Title"] = "Create";
}

@await Html.PartialAsync("_MenuHome", Model.UserCreateModel.MenuModel)
        
        <h1>Create</h1>
        
    <h4>AdminUser</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>
            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.FirstName" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.FirstName" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.LastName" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.LastName" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.UserName" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.UserName" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.Description" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.Description" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.Description" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.Email" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.Email" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.Password" class="control-label"></label>
                <input asp-for="UserCreateModel.UserModel.DTO.Password" class="form-control" />
                <span asp-validation-for="UserCreateModel.UserModel.DTO.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserCreateModel.UserModel.DTO.Role" class="control-label"></label>
                <select asp-for="UserCreateModel.UserModel.DTO.Role" class="form-control" asp-items="Model.UserCreateModel.RoleOptions" multiple="multiple"></select>
                <span asp-validation-for="UserCreateModel.UserModel.DTO.Role" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="UserCreateModel.UserModel.PhotoFile" class="form-label">Photo du projet</label>
                    <input type="file" name="PhotoFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Formats acceptés : JPG, PNG, GIF, WebP (max 5 MB)</small>
                </div>
            </div>

            <div id="photoPreview" class="mb-3 text-center">
                <p class="text-muted">Aucune image sélectionnée</p>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts 
{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_FileInputScriptsPartial");}
}
