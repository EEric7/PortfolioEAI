@page
@model IndexModel
@{
    ViewData["Title"] = "ELEMBA ADI Eric";
    ViewData["SubTitle"] = "Developeur .NET";
    ViewData["LinkGrayscale"] = "https://startbootstrap.com/theme/grayscale/";
}
<!--Master Head-->
<header class="masthead">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center">
                <h1 class="mx-auto my-0 text-uppercase">@ViewData["Title"]</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5">@ViewData["SubTitle"]</h2>
                <a class="btn btn-primary" href="#about">Qui-suis je?</a>
            </div>
        </div>
    </div>
</header>

<!-- 
About-->
<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white mb-4">@((Model.AccueilModel.AdminUserModel != null && Model.AccueilModel.AdminUserModel.UserName != null) ? Model.AccueilModel.AdminUserModel.UserName : string.Empty)</h2>
                <p class="text-white-50">
                    @((Model.AccueilModel.AdminUserModel != null && Model.AccueilModel.AdminUserModel.Description != null) ? Model.AccueilModel.AdminUserModel.Description : string.Empty)
                </p>
            </div>
        </div>
        <img class="img-fluid" src="assets/img/Moi.png" alt="..." />
    </div>
</section>

<!-- Projects-->
<section class="projects-section bg-light" id="skills">
    <div class="container px-4 px-lg-5">
         <!-- Featured Compétence Row-->
        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">
                @if (Model.AccueilModel.AdminUserModel != null && Model.AccueilModel.AdminUserModel.Skills != null)
                {
                    <h2 class="text-black mb-4">PROGRAMMING LANGUAGE & TOOLS</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Languages).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Framwork).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <h2 class="text-black mb-4">WORKFLOW</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Design).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    
                    <h2 class="text-black mb-4">C.V</h2>
                    <a href="#!">
                        <img class="img-fluid" src="assets/cv.ico" alt="..." />
                        Download
                    </a>
                </div>
            </div>
        </div>

        <h2 class="text-black mb-4" id="projects">EXPERIENCE</h2>
        @if (Model.AccueilModel.ProjectsModel != null && Model.AccueilModel.ProjectsModel.Any())
        {
            <!-- Project One Row-->
            @if (Model.AccueilModel.ProjectsModel.Count >= 1 && Model.AccueilModel.ProjectsModel[0] != null)
            {
                <div class="row gx-0 mb-5 mb-lg-0 justify-content-center">
                    <div class="col-lg-6">
                        <img class="img-fluid" src=@(Model.AccueilModel.ProjectsModel[0].ImageUrl) alt="..." />
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-black text-center h-100 project">
                            <div class="d-flex h-100">
                                <div class="project-text w-100 my-auto text-center text-lg-left">
                                    <h4 class="text-white">@(Model.AccueilModel.ProjectsModel[0].Title)</h4>
                                    <p class="mb-0 text-white-50">
                                        @(Model.AccueilModel.ProjectsModel[0].Description)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <!-- Project Two Row-->
            @if (Model.AccueilModel.ProjectsModel.Count >= 2)
            {
                <div class="row gx-0 justify-content-center">
                    <div class="col-lg-6">
                        <img class="img-fluid" src=@(Model.AccueilModel.ProjectsModel[1].ImageUrl) alt="..." />
                    </div>
                    <div class="col-lg-6 order-lg-first">
                        <div class="bg-black text-center h-100 project">
                            <div class="d-flex h-100">
                                <div class="project-text w-100 my-auto text-center text-lg-right">
                                    <h4 class="text-white">
                                        @(Model.AccueilModel.ProjectsModel[1].Title)
                                    </h4>
                                    <p class="mb-0 text-white-50">
                                        @(Model.AccueilModel.ProjectsModel[1].Description)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <!-- Project 3 Row-->
            @if (Model.AccueilModel.ProjectsModel.Count >= 3)
            {
                <div class="row gx-0 mb-5 mb-lg-0 justify-content-center">
                    <div class="col-lg-6"><img class="img-fluid" src=@(Model.AccueilModel.ProjectsModel[2].ImageUrl) alt="..." /></div>
                    <div class="col-lg-6">
                        <div class="bg-black text-center h-100 project">
                            <div class="d-flex h-100">
                                <div class="project-text w-100 my-auto text-center text-lg-left">
                                    <h4 class="text-white">
                                        @(Model.AccueilModel.ProjectsModel[2].Title)
                                    </h4>
                                    <p class="mb-0 text-white-50">
                                        @(Model.AccueilModel.ProjectsModel[2].Description)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- Credit-->
<section class="signup-section" id="privacy">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <h2 class="text-white mb-4">Built with ASP.NET Core Razor</h2>
                <p class="text-white-50">
                    Ce modèle est un thème Bootstrap gratuit créé par Start Bootstrap. Il peut être à vous dès maintenant : téléchargez simplement le modèle sur 
                    <a href="https://startbootstrap.com/theme/grayscale/">la page de prévisualisation.</a> 
                    Le thème est open source, et vous pouvez l’utiliser à n’importe quelle fin, qu’elle soit personnelle ou commerciale.
                </p>
            </div>
         </div>
    </div>
</section>

<!-- Contact-->
<section class="contact-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">Address</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">25 rue des carmes, 67100 Strasbourg Fr</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">Email</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50"><a href="#!">@((Model.AdminUser != null && Model.AdminUser.Email != null) ? Model.AdminUser.Email : string.Empty)</a></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">Phone</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">+33 6 16 55 13 36</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="social d-flex justify-content-center"></div>
            <a class="mx-2" href="https://github.com/EEric7"><i class="fab fa-github"></i></a>
        </div>
    </div>
</section>
