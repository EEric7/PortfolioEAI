@page
@using PortfolioEAI.Application.Ressources
@model IndexModel
@{
    ViewData["Title"] = Model.AccueilModel?.AdminUserModel?.UserName ?? UIText.DefaultTitle;
    ViewData["SubTitle"] = Model.AccueilModel?.AdminUserModel?.Profession ?? UIText.DefaultProfession;
    ViewData["LinkGrayscale"] = "https://startbootstrap.com/theme/grayscale/";
}

@await Html.PartialAsync("_Menu")

<!--Master Head-->
<header class="masthead">
    <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
        <div class="d-flex justify-content-center">
            <div class="text-center">
                <h1 class="mx-auto my-0 text-uppercase">@ViewData["Title"]</h1>
                <h2 class="text-white-50 mx-auto mt-2 mb-5">@ViewData["SubTitle"]</h2>
                <a class="btn btn-primary" href="#about"> @UIText.WhoAmIButton</a>
            </div>
        </div>
    </div>
</header>

<!-- 
About-->
<section class="about-section text-center" id="about">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-lg-8">
                <h2 class="text-white mb-4">@((Model.AccueilModel?.AdminUserModel?.UserName))</h2>
                <p class="text-white-50">
                    @(Model.AccueilModel?.AdminUserModel?.Description)
                </p>
            </div>
        </div>
        <img class="img-fluid" src="assets/img/Moi.png" alt="@UIText.ProfileImageAlt" />
    </div>
</section>

<!-- Projects-->
<section class="projects-section bg-light" id="skills">
    <div class="container px-4 px-lg-5">
         <!-- Featured Compétence Row-->
        <div class="row gx-0 mb-4 mb-lg-5 align-items-center">
            <div class="col-xl-8 col-lg-7">
                @if (Model.AccueilModel?.AdminUserModel != null && Model.AccueilModel.AdminUserModel.SkillsModel != null)
                {
                    <h2 class="text-black mb-4">@UIText.SkillsLanguageHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.AdminUserModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Languages).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.AdminUserModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Framwork).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor;">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <h2 class="text-black mb-4">@UIText.SkillsWorkflowHeader</h2>
                    <div class="col-xl-8 col-lg-7">
                        <div class="container"></div>
                        <div class="row">
                            <div class="col-md-6">
                                @foreach (var skill in Model.AccueilModel.AdminUserModel.SkillsModel.Where(s => s.Category == Domain.Enums.SkillCategory.Design).OrderBy(z => z.Name))
                                {
                                    <h3 class="progressbar-title">@skill.Name</h3>
                                    <div class="progress">
                                        <div class="progress-bar" style="width:@((int)(skill.Level ?? 0))%; background:@skill.LevelBackgroundColor">
                                            <span class="progress-value">@skill.Level</span>
                                            <span class="progress-icon" style="border-bottom-color:@skill.LevelBackgroundColor;"></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-xl-4 col-lg-5">
                <div class="featured-text text-center text-lg-left">
                    
                    <h2 class="text-black mb-4">@UIText.CVHeader</h2>
                    <a href="#!">
                        <img class="img-fluid" src="assets/cv.ico" alt="@UIText.CVImageAlt" width="300" height="300"/>
                        @UIText.DownloadLabel
                    </a>
                </div>
            </div>
        </div>

        <h2 class="text-black mb-4" id="projects">@UIText.ExperiencesHeader</h2>
        @if (Model.AccueilModel?.AdminUserModel?.ExperienceModel?.Any() == true) {

            List<Application.Models.ProjectModel>? projectsModel = Model.AccueilModel.AdminUserModel.ExperienceModel
            .SelectMany(e => e.ProjectsModel)
            .Take(3)
            .ToList();

            @for (int i = 0; i < 3; i++) {
                @if ((i % 2) == 1) {
                    <!-- Project One Row-->
                    <div class="row gx-0 mb-5 mb-lg-0 justify-content-center">
                        <div class="col-lg-6">
                            <img class="img-fluid" src=@(projectsModel[i].ImageUrl) alt="@UIText.ProjectImageAlt" />
                        </div>
                        <div class="col-lg-6">
                            <div class="bg-black text-center h-100 project">
                                <div class="d-flex h-100">
                                    <div class="project-text w-100 my-auto text-center text-lg-left">
                                        <h4 class="text-white">@(projectsModel[i].Title)</h4>
                                        <p class="mb-0 text-white-50">
                                            @(projectsModel[i].Description)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                } 
                else {
                    <!-- Project Two Row-->
                    <div class="row gx-0 justify-content-center">
                        <div class="col-lg-6">
                            <img class="img-fluid" src=@(projectsModel[i].ImageUrl) alt="@UIText.ProjectImageAlt" />
                        </div>
                        <div class="col-lg-6 order-lg-first">
                            <div class="bg-black text-center h-100 project">
                                <div class="d-flex h-100">
                                    <div class="project-text w-100 my-auto text-center text-lg-right">
                                        <h4 class="text-white">
                                            @(projectsModel[i].Title)
                                        </h4>
                                        <p class="mb-0 text-white-50">
                                            @(projectsModel[i].Description)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</section>

<!-- Credit-->
<section class="signup-section" id="privacy">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-10 col-lg-8 mx-auto text-center">
                <h2 class="text-white mb-4">@UIText.ProjectsTitle</h2>
                <p class="text-white-50">
                    @UIText.ProjectsDescription
                </p>
            </div>
         </div>
    </div>
</section>

<!-- Contact-->
<section class="contact-section bg-black" id="contacts">
    <div class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.AddressLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@Model.AccueilModel?.AdminUserModel?.GetFullAddress()</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.EmailLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50"><a href="#!">@Model.AccueilModel?.AdminUserModel?.Email</a></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card py-4 h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-mobile-alt text-primary mb-2"></i>
                        <h4 class="text-uppercase m-0">@UIText.PhoneLabel</h4>
                        <hr class="my-4 mx-auto" />
                        <div class="small text-black-50">@Model.AccueilModel?.AdminUserModel?.Number</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="social d-flex justify-content-center">
            <a class="mx-2" href=@Model.AccueilModel?.AdminUserModel?.EmailGitHub>
                <i class="fab fa-github"></i>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js"></script>
}