@page
@model PortfolioEAI.Pages.Dashbord.Skills.IndexModel

@{
    ViewData["Title"] = "Compétences";
}

@await Html.PartialAsync("_MenuHome", Model)

<section class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-0">Compétences</h2>
            <small class="text-muted">Gestion des compétences du portfolio</small>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 w-100 w-md-auto">
            <div class="input-group">
                <form class="d-flex w-100" asp-page-handler="Search" method="post">
                    <input type="search"
                        name="query"
                        value="@Model.Query"
                        class="form-control form-control-sm"
                        placeholder="Rechercher une compétence..." 
                        aria-label="Rechercher"/>
                    <button class="btn btn-sm btn-outline-secondary" type="submit" title="Rechercher">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary" title="Réinitialiser">
                        <i class="fas fa-times"></i>
                    </a>
                }

                <div class="d-flex gap-2">
                    <a asp-page="Create" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i> Nouvelle compétence
                    </a>
                    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary" title="Rafraîchir">
                        <i class="fas fa-sync-alt"></i>
                    </a>
                </div>
            </div>    
        </div>
    </div>

    @if (Model?.Skills == null || !Model.Skills.Any())
    {
        <div class="alert alert-info">Aucune compétence trouvée. Cliquez sur <strong>Nouvelle compétence</strong> pour en ajouter.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table id="skillsTable" class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:40%;">
                            @Html.DisplayNameFor(model => model.Skills[0].Name)
                        </th>
                        <th class="text-center" style="width:120px;">
                            @Html.DisplayNameFor(model => model.Skills[0].Level)
                        </th>
                        <th style="width:25%;">
                            @Html.DisplayNameFor(model => model.Skills[0].Category)
                        </th>
                        <th class="text-end" style="width:180px;">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Skills)
                    {
                        <tr>
                            <td class="align-middle">
                                <div class="d-flex flex-column">
                                    <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                    <small class="text-muted">@item.Id</small>
                                </div>
                            </td>
                            <td class="align-middle text-center">
                                @Html.DisplayFor(modelItem => item.Level)
                            </td>
                            <td class="align-middle">
                                @Html.DisplayFor(modelItem => item.Category)
                            </td>
                            <td class="align-middle text-end">
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Détails">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Confirmez-vous la suppression de cette compétence ?');" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
}
